{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@flow/listening/*": ["../reader/src/listening/*"],
      "react": ["../reader/node_modules/@types/react"],
      "react/*": ["../reader/node_modules/@types/react/*"],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*",
        "../../packages/internal/node_modules/@types/react-dom/*"
      ]
    }
  },
  "include": ["src"]
}
